//Find the smallest element in an array

import java.util.Scanner;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int sz = sc.nextInt();
		int arr[] = new int[sz];
		for(int i=0;i<sz;i++){
		    arr[i] = sc.nextInt();
		}
		int min = arr[0];
		for(int i=0;i<sz;i++){
		    if(arr[i]<min){
		        min = arr[i];
		    }
		}
		System.out.print(min);
	}
}
